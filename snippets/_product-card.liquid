{% doc %}
  Renders a single product card for use inside product list sections or carousels.

  @param {product} [product] - The product to render. Can be blank for a placeholder.
  @param {string} [loading] - Loading attribute for the main image ("lazy" by default).

  @example
  {% render '_product-card', product: product, loading: 'lazy' %}
{% enddoc %}

<li class="best-sellers__item">
  <article class="product-card">
    <a href="{{ product.url | default: '#' }}" class="block group">
      <div class="product-card__image-wrap relative aspect-square rounded-[10px] overflow-hidden bg-gray-100">
        {% if product != blank and product.featured_image %}
          <img
            class="product-card__img product-card__img--primary absolute inset-0 w-full h-full object-cover transition-opacity duration-200 group-hover:opacity-0"
            src="{{ product.featured_image | image_url: width: 400 }}"
            alt="{{ product.featured_image.alt | default: product.title }}"
            width="400"
            height="400"
            loading="{{ loading | default: 'lazy' }}"
          />
          {% if product.images[1] %}
            <img
              class="product-card__img product-card__img--secondary absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-200 group-hover:opacity-100"
              src="{{ product.images[1] | image_url: width: 400 }}"
              alt=""
              width="400"
              height="400"
              aria-hidden="true"
            />
          {% endif %}
        {% endif %}
        <div class="product-card__badges absolute top-2 left-2 right-3 flex justify-between items-center gap-2.5 pointer-events-none">
          <span class="product-card__badge product-card__badge--left product-card__badge--left-mobile" aria-hidden="true"></span>
          <span class="product-card__badge product-card__badge--left product-card__badge--left-desktop" aria-hidden="true"></span>
          <span class="product-card__badge product-card__badge--right product-card__badge--right-mobile" aria-hidden="true"></span>
          <span class="product-card__badge product-card__badge--right product-card__badge--right-desktop" aria-hidden="true"></span>
        </div>
      </div>
      <div class="mt-3 px-2 pb-[9px] flex flex-col gap-2">
        <h3 class="product-card__title font-normal line-clamp-2">{{ product.title | default: 'Product' }}</h3>
        <div class="flex items-center gap-1 text-xs">
          <span class="product-card__rating" aria-hidden="true"></span>
          <span class="sr-only product-card__rating-sr">Rated {% if product != blank and product.metafields.reviews.rating.value %}{{ product.metafields.reviews.rating.value }}{% else %}5{% endif %} out of 5 stars</span>
          <span class="product-card__reviews">{% if product != blank and product.metafields.reviews.rating_count %}{{ product.metafields.reviews.rating_count }}{% else %}0{% endif %} Reviews</span>
        </div>
        <p class="product-card__price text-base">{% if product != blank %}{{ product.price | money }}{% else %}$0.00{% endif %}</p>
      </div>
    </a>
  </article>
</li>
